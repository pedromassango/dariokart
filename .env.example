# Firebase web config for online multiplayer (Realtime Database).
# Copy to .env.local and fill in. Without these, online mode is disabled
# and the game still runs fully offline (vs bots).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local testing without a Firebase project: run `npx firebase-tools emulators:start --project demo-dariokart`
# and set this to 1.
VITE_FIREBASE_EMULATOR=
