{
  "database": { "rules": "database.rules.json" },
  "emulators": { "database": { "port": 9000 }, "auth": { "port": 9099 }, "ui": { "enabled": false } },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{ "source": "**/*.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }]
  }
}
