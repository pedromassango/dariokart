  },
  "dependencies": {
    "@rive-app/canvas-advanced": "^2.44.2",
    "firebase": "^13.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
