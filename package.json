{
  "name": "dariokart",
  "version": "1.0.0",
  "private": true,
  "description": "Dariokart \u2014 a Super Mario Kart\u2013inspired kart racer for the web, rendered entirely with Rive (custom 3D engine on the Rive renderer + Rive artboards), bots at three difficulty levels, procedural chiptune audio and Firebase online multiplayer.",
  "license": "MIT",
  "author": "Pedro Massango",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedromassango/dariokart.git"
  },
  "homepage": "https://github.com/pedromassango/dariokart#readme",
  "bugs": {
    "url": "https://github.com/pedromassango/dariokart/issues"
  },
  "keywords": [
    "rive",
    "kart",
    "racing",
    "game",
    "firebase",
    "multiplayer",
    "mario-kart",
    "fan-game",
    "3d-engine"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run riv && tsc --noEmit && vite build",
    "preview": "vite preview",
    "riv": "node scripts/rivgen/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/simulate.ts",
    "difficulty": "tsx scripts/difficulty-report.ts",
    "demo": "bash scripts/demo/make-demo.sh"
  },
  "dependencies": {
    "@rive-app/canvas-advanced": "^2.44.2",
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "playwright": "^1.59.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
